# Fixed production origin used by the server-side read-only proxy.
# Do not put admin credentials here.
SAFE_ZONE_VPS_ORIGIN=https://safe.quorix.io.vn
PORT=8080

# The hand-off dialog displays these values intentionally as public guest
# access details. They are bundled into the demo and are not secrets.
# Keep this account read-only and never reuse it for an administrator.
VITE_SAFE_ZONE_PRODUCTION_URL=https://safe.quorix.io.vn
VITE_PUBLIC_GUEST_USERNAME=guest
VITE_PUBLIC_GUEST_PASSWORD=replace-with-current-public-guest-password
